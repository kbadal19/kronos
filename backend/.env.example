# Copy to backend/.env and fill in. Never commit the real file.

# --- Django ---
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
DEBUG=False
ALLOWED_HOSTS=secondmind.yourdomain.com,graph.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://secondmind.yourdomain.com,https://graph.yourdomain.com
# Only the graph web page needs CORS; the Expo app does not.
CORS_ALLOWED_ORIGINS=https://graph.yourdomain.com

# --- Database (docker-compose supplies these in containers) ---
DB_NAME=secondmind
DB_USER=secondmind
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# --- Transcription ---
# $200 free credit on signup covers roughly the first nine months at
# 15 min/day. Run the bake-off on your own voice before committing.
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# multi = Hindi/English code-switching. "en" for English-only.
DEEPGRAM_LANGUAGE=multi
TRANSCRIPTION_KEYTERM_LIMIT=100
TRANSCRIPTION_KEYTERM_TOKEN_BUDGET=450

# --- LLM ---
# A NEW key on its OWN Google Cloud project — deliberately not the one
# masterflow uses. Set a hard budget alert (~$10/mo) while prompts are
# still being tuned; a runaway retry loop is the realistic way to get a
# surprising bill out of this.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_SMART_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Thinking for Ask: a level (low, high), a token budget (0 = off), or
# blank for the model's default. Default thinking measured ~4x slower than
# "low" on real questions with no better answers.
# ASK_PLAN_THINKING=0
# ASK_ANSWER_THINKING=low

# Normalize pass (Gemini listens to the audio and fixes the transcript).
# Defaults to on whenever GEMINI_API_KEY is set.
# NORMALIZE_ENABLED=true
# NORMALIZE_MODEL=gemini-flash-lite-latest
# NORMALIZE_FALLBACK_MODEL=gemini-flash-latest
NORMALIZE_RECENT_CONTEXT=5

# --- Audio retention ---
# Audio is spooled only between upload and a committed raw transcript.
#   336 (14 days) during Phase 0 — you need real audio to benchmark STT
#                  providers against, and this is your only chance to keep
#                  any, since nothing downstream stores it.
#   24            afterwards, so a garbled transcription can be retried.
#   0             delete the instant the transcript commits.
AUDIO_RETENTION_HOURS=336
MAX_CAPTURE_BYTES=52428800

# --- Pipeline tuning (Phase 1+) ---
EDGE_CONFIDENCE_AUTO=0.90
EDGE_CONFIDENCE_REVIEW=0.70
SEGMENTATION_SPLIT_THRESHOLD_SECONDS=90

# --- Optional ---
# pip install "sentry-sdk[django]" to enable. Worth it: the failure mode
# this system has to defend against is silent.
SENTRY_DSN=

# --- Backups (scripts/backup.sh) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=secondmind-backups
# Public half of an age keypair. Keep the PRIVATE half off this server —
# a backup encrypted with a key that lives next to it protects nothing.
BACKUP_AGE_PUBLIC_KEY=
